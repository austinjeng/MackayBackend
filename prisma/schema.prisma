generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Models ---

// 病患
model Patient {
  id        String   @id @map("病患ID")
  apiKey    String   @unique @default(cuid()) @map("API金鑰")
  name      String   @map("姓名")
  dob       DateTime @map("出生日期") @db.Date
  createdAt DateTime @default(now()) @map("建立時間")
  updatedAt DateTime @updatedAt @map("上次更新時間")

  sessions RehabSession[]

  @@map("病患") // table name
}

// 運動類型
model ExerciseType {
  id        Int      @id @default(autoincrement()) @map("運動類型ID") @db.SmallInt
  code      String   @unique @map("代碼")
  name      String   @map("名稱")
  createdAt DateTime @default(now()) @map("建立時間")
  updatedAt DateTime @updatedAt @map("上次更新時間")

  sessionExercises RehabSessionExercise[]

  @@map("運動類型")
}

// 運動會話
model RehabSession {
  id        Int           @id @default(autoincrement()) @map("會話ID")
  patientId String        @map("病患ID")
  sessionDate DateTime    @map("會話日期") @db.Date
  startedAt DateTime      @map("開始時間")
  endedAt   DateTime?     @map("結束時間")
  status    RehabSessionStatus @default(open) @map("狀態")
  createdAt DateTime      @default(now()) @map("建立時間")
  updatedAt DateTime      @updatedAt @map("上次更新時間")

  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionExercises RehabSessionExercise[]

  @@index([patientId, startedAt(sort: Desc)])
  @@unique([patientId, sessionDate])
  @@map("運動會話")
}

// 會話運動
model RehabSessionExercise {
  id             Int                   @id @default(autoincrement()) @map("會話運動ID")
  sessionId      Int                   @map("會話ID")
  exerciseTypeId Int                   @map("運動類型ID")
  status         RehabSessionExerciseStatus @default(open) @map("狀態")
  startedAt      DateTime?             @map("開始時間")
  endedAt        DateTime?             @map("結束時間")
  createdAt      DateTime              @default(now()) @map("建立時間")
  updatedAt      DateTime              @updatedAt @map("上次更新時間")

  session      RehabSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseType ExerciseType    @relation(fields: [exerciseTypeId], references: [id], onDelete: Restrict)
  attempts     ExerciseAttempt[]

  @@index([sessionId])
  @@unique([sessionId, exerciseTypeId])
  @@map("會話運動")
}

enum RehabSessionStatus {
  open    @map("開啟")
  closed  @map("關閉")
  aborted @map("中止")
}

enum RehabSessionExerciseStatus {
  open    @map("開啟")
  closed  @map("關閉")
  aborted @map("中止")
}

enum AttemptOutcome {
  success @map("成功")
  fail    @map("失敗")
  invalid @map("無效")
}

// 通用運動紀錄
model ExerciseAttempt {
  id                Int            @id @default(autoincrement()) @map("紀錄ID")
  sessionExerciseId Int            @map("會話運動ID")
  startedAt         DateTime       @map("開始時間")
  endedAt           DateTime?      @map("結束時間")
  outcome           AttemptOutcome @map("結果")
  data              Json?          @map("數據")
  createdAt         DateTime       @default(now()) @map("建立時間")
  updatedAt         DateTime       @updatedAt @map("上次更新時間")

  sessionExercise RehabSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId, startedAt(sort: Desc)])
  @@index([outcome])
  @@map("運動紀錄")
}


// --- Auth ---

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  admin         Admin?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @unique
}
