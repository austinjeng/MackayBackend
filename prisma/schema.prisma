generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Models ---

// 病患
model Patient {
  id        String   @id @map("病患ID")
  name      String   @map("姓名")
  dob       DateTime @map("出生日期") @db.Date
  createdAt DateTime @default(now()) @map("建立時間")
  updatedAt DateTime @updatedAt @map("上次更新時間")

  sessions Session[]

  @@map("病患") // table name
}

// 運動類型
model ExerciseType {
  id        Int      @id @default(autoincrement()) @map("運動類型ID") @db.SmallInt
  code      String   @unique @map("代碼")
  name      String   @map("名稱")
  createdAt DateTime @default(now()) @map("建立時間")
  updatedAt DateTime @updatedAt @map("上次更新時間")

  sessionExercises SessionExercise[]

  @@map("運動類型")
}

// 運動會話
model Session {
  id        Int           @id @default(autoincrement()) @map("會話ID")
  patientId String        @map("病患ID")
  startedAt DateTime      @map("開始時間")
  endedAt   DateTime?     @map("結束時間")
  status    SessionStatus @default(open) @map("狀態")
  createdAt DateTime      @default(now()) @map("建立時間")
  updatedAt DateTime      @updatedAt @map("上次更新時間")

  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionExercises SessionExercise[]

  @@index([patientId, startedAt(sort: Desc)])
  @@map("運動會話")
}

// 會話運動
model SessionExercise {
  id             Int                   @id @default(autoincrement()) @map("會話運動ID")
  sessionId      Int                   @map("會話ID")
  exerciseTypeId Int                   @map("運動類型ID")
  status         SessionExerciseStatus @default(open) @map("狀態")
  startedAt      DateTime?             @map("開始時間")
  endedAt        DateTime?             @map("結束時間")
  createdAt      DateTime              @default(now()) @map("建立時間")
  updatedAt      DateTime              @updatedAt @map("上次更新時間")

  session                         Session                           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseType                    ExerciseType                      @relation(fields: [exerciseTypeId], references: [id], onDelete: Restrict)
  ExerciseAlternatingKneesAttempt ExerciseAlternatingKneesAttempt[]
  ExerciseHeelToToeWalkAttempt ExerciseHeelToToeWalkAttempt[]
  ExerciseSideStepsAttempt ExerciseSideStepsAttempt[]
  ExerciseSquatAttempt ExerciseSquatAttempt[]
  ExerciseTiptoeStandAttempt ExerciseTiptoeStandAttempt[]

  @@index([sessionId])
  @@map("會話運動")
}

enum SessionStatus {
  open    @map("開啟")
  closed  @map("關閉")
  aborted @map("中止")
}

enum SessionExerciseStatus {
  open    @map("開啟")
  closed  @map("關閉")
  aborted @map("中止")
}

enum AttemptOutcome {
  success @map("成功")
  fail    @map("失敗")
  invalid @map("無效")
}

// 雙膝交互​抬​高(側)紀錄
model ExerciseAlternatingKneesAttempt {
  id                Int            @id @default(autoincrement()) @map("紀錄ID")
  sessionExerciseId Int            @map("會話運動ID")
  startedAt         DateTime       @map("開始時間")
  endedAt           DateTime?      @map("結束時間")
  outcome           AttemptOutcome @map("結果")
  angleDeg          Decimal        @map("角度") @db.Decimal(6, 3)
  createdAt         DateTime       @default(now()) @map("建立時間")
  updatedAt         DateTime       @updatedAt @map("上次更新時間")

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId, startedAt(sort: Desc)])
  @@index([outcome])
  @@map("雙膝交互​抬​高(側)")
}

// 腳尖​對腳​跟紀錄
model ExerciseHeelToToeWalkAttempt {
  id                Int            @id @default(autoincrement()) @map("紀錄ID")
  sessionExerciseId Int            @map("會話運動ID")
  startedAt         DateTime       @map("開始時間")
  endedAt           DateTime?      @map("結束時間")
  outcome           AttemptOutcome @map("結果")
  createdAt         DateTime       @default(now()) @map("建立時間")
  updatedAt         DateTime       @updatedAt @map("上次更新時間")

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId, startedAt(sort: Desc)])
  @@index([outcome])
  @@map("腳尖​對腳​跟​")
}


// 左右跨步紀錄
model ExerciseSideStepsAttempt {
  id                Int            @id @default(autoincrement()) @map("紀錄ID")
  sessionExerciseId Int            @map("會話運動ID")
  startedAt         DateTime       @map("開始時間")
  endedAt           DateTime?      @map("結束時間")
  outcome           AttemptOutcome @map("結果")
  angleDeg          Decimal        @map("角度") @db.Decimal(6, 3)
  createdAt         DateTime       @default(now()) @map("建立時間")
  updatedAt         DateTime       @updatedAt @map("上次更新時間")

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId, startedAt(sort: Desc)])
  @@index([outcome])
  @@map("左右跨步​")
}

// 深蹲紀錄
model ExerciseSquatAttempt {
  id                Int            @id @default(autoincrement()) @map("紀錄ID")
  sessionExerciseId Int            @map("會話運動ID")
  startedAt         DateTime       @map("開始時間")
  endedAt           DateTime?      @map("結束時間")
  outcome           AttemptOutcome @map("結果")
  angleDeg          Decimal        @map("角度") @db.Decimal(6, 3)
  createdAt         DateTime       @default(now()) @map("建立時間")
  updatedAt         DateTime       @updatedAt @map("上次更新時間")

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId, startedAt(sort: Desc)])
  @@index([outcome])
  @@map("深蹲​")
}

//墊腳尖站​立紀錄
model ExerciseTiptoeStandAttempt {
  id                Int            @id @default(autoincrement()) @map("紀錄ID")
  sessionExerciseId Int            @map("會話運動ID")
  startedAt         DateTime       @map("開始時間")
  endedAt           DateTime?      @map("結束時間")
  outcome           AttemptOutcome @map("結果")
  angleDeg          Decimal        @map("角度") @db.Decimal(6, 3)
  holdSeconds       Decimal        @map("維持秒數") @db.Decimal(6, 3)
  createdAt         DateTime       @default(now()) @map("建立時間")
  updatedAt         DateTime       @updatedAt @map("上次更新時間")

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId, startedAt(sort: Desc)])
  @@index([outcome])
  @@map("墊腳尖站​立​")
}