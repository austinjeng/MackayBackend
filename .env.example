# Replace with the connection string from your Neon project
DATABASE_URL="postgresql://user:password@host:port/db?sslmode=require"

# You can generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# Admin credentials for production seeding
ADMIN_EMAIL=""
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Set to true to allow running seed.prod.ts when NODE_ENV is not production
SEED_ALLOW_PROD="false"
